def top(stu):
    high=[]
    for i in stu.values():
        high.append(i[1])
    high.sort(reverse=True)
    x=[]
    for i in range(3):
        x.append(high[i])
    print("Top 3 scores are")
    for i in x:
        print(f"{i}\n")



