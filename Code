def add(stu):
    x=int(input("How many students do you want to enter today:"))
    count=0
    while x!=count:
        serial=input("Enter student's id:")
        name=input("Enter student's name:")
        while True:
            marks = int(input("Enter his/her total marks and they should be under 1200:"))
            if 0<marks<=1200:
                break
            else:
                print("Invalid marks!!")
        stu[serial]=name,marks
        count+=1
def delete(stu):
    x=input("Enter id of a student you want to delete record for:")
    if x in stu:
        del stu[x]
    else:
        print("Student not found!!")
def ch(stu):
    x=input("Enter id of student you want to update marks of:")
    if x in stu:
        name=stu[x][0]
        while True:
            marks = int(input("Enter his/her total marks and they should be under 1200:"))
            if 0<marks<=1200:
                break
            else:
                print("Invalid marks!!")
        stu[x]=name,marks
    else:
        print("Id not found!!")
def search(stu):
    x=input("enter id of the student:")
    if x in stu:
        print(stu[x])
    else:
        print("Id not found!!")
def high(stu):
    mark = []
    for i in stu.values():
        mark.append(i[1])
    print(max(mark))
def low(stu):
    mark = []
    for i in stu.values():
        mark.append(i[1])
    print(min(mark))
def ave(stu):
    mark=[]
    for i in stu.values():
        mark.append(i[1])
    print(sum(mark)/len(mark))
